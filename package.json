{
  "name": "hisinf",
  "version": "1.0.0",
  "description": "Tarixiy ma'lumotlar portali (Next.js + Payload CMS 3)",
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" next dev",
    "devsafe": "node -e \"const fs = require('fs'); if (fs.existsSync('.next')) fs.rmSync('.next', { recursive: true, force: true })\" && cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "migrate:create": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload migrate",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload run src/seed/index.ts",
    "ci": "payload migrate && pnpm build",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" next start",
    "test": "vitest run",
    "test:all": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "v2:script": "cross-env NODE_OPTIONS=\"--no-deprecation --require ./scripts/swc-fix.cjs\" payload run"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "jsdom": "^25.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "mammoth": "^1.13.0",
    "next": "15.4.11",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.29",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-leaflet": "^5.0.0",
    "resend": "^6.32.1",
    "sharp": "0.33.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.49.0",
    "@swc/core-win32-x64-msvc": "^1.16.13",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
